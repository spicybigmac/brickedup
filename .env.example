# Optional for the public Space; recommended for better Hugging Face rate limits.
HF_TOKEN=
HF_SPACE_ID=Upsampler/stable-fast-3d
HF_SPACE_API_NAME=/image_to_glb

# Stable Fast 3D generation settings.
SF3D_PROVIDER=huggingface
SF3D_NGROK_URL=
SF3D_NGROK_TIMEOUT_SECONDS=300
SF3D_NGROK_REMESH=triangle
SF3D_FOREGROUND_RATIO=0.85
SF3D_REMESH=None
SF3D_VERTEX_COUNT=-1
SF3D_TEXTURE_SIZE=1024
VOXEL_TARGET_STUDS=32
VOXEL_MAX_CELLS=35000

# Set to 1 only for offline development and automated tests.
SF3D_DEMO_MODE=0

# Optional: without this key, the PDF uses built-in instructional copy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runtime tuning
PORT=8000
MAX_UPLOAD_MB=10
WORKER_THREADS=2
